# Copy to .env.production on the VPS. Never commit the populated file.
DOMAIN=fieldmate.example.com

POSTGRES_DB=fieldmate
POSTGRES_USER=fieldmate
# Use URL-safe random characters because this value is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

SESSION_COOKIE_NAME=fieldmate_session
SESSION_TTL_HOURS=168
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=10

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Shared password for the seeded technician and supervisor demo accounts.
DEMO_USER_PASSWORD=replace-with-a-unique-demo-password

INVITE_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30

ASSEMBLYAI_API_KEY=replace-with-your-assemblyai-api-key
ASSEMBLYAI_VOICE=alba
