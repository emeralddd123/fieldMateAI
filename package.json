{
  "name": "fieldmate-ai",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @fieldmate/shared build && pnpm --parallel --filter @fieldmate/shared --filter @fieldmate/api --filter @fieldmate/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @fieldmate/shared build && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @fieldmate/api prisma:generate",
    "db:migrate": "pnpm --filter @fieldmate/api prisma:migrate",
    "db:seed": "pnpm --filter @fieldmate/api seed",
    "admin:create": "pnpm --filter @fieldmate/api admin:create",
    "test:integration": "pnpm --filter @fieldmate/api test:integration",
    "test:e2e": "playwright test",
    "test:e2e:writes": "WRITE_E2E=1 TEST_WEB_URL=http://localhost:55173 playwright test tests/e2e/write-path.spec.ts --project=desktop --workers=1",
    "demo:api": "node scripts/demo.mjs",
    "test:maintenance": "node --env-file=.env.test --test apps/api/test/maintenance.integration.test.mjs",
    "test:auth": "node --env-file=.env.test --test apps/api/test/auth.integration.test.mjs",
    "test:rbac": "node --env-file=.env.test --test apps/api/test/rbac.integration.test.mjs",
    "test:admin": "node --env-file=.env.test --test apps/api/test/admin-users.integration.test.mjs",
    "test:admin:resources": "node --env-file=.env.test --test apps/api/test/admin-sites-assets.integration.test.mjs",
    "test:admin:knowledge": "node --env-file=.env.test --test apps/api/test/admin-faults-procedures.integration.test.mjs",
    "test:admin:audit": "node --env-file=.env.test --test apps/api/test/admin-audit-cleanup.integration.test.mjs",
    "test:voice": "pnpm --filter @fieldmate/api build && pnpm --filter @fieldmate/api exec tsx --test test/voice.test.mjs ../web/test/voice.test.mjs ../web/test/work-mode.test.mjs ../web/test/qr-scanner.test.mjs",
    "test:voice:live": "node scripts/voice-smoke.mjs",
    "test:voice:live:writes": "node scripts/voice-smoke.mjs --writes"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
