generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  operational
  warning
  down
  maintenance
}

model Organization {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  slug             String                   @unique
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  archivedAt       DateTime?                @map("archived_at")
  sites            Site[]
  assets           Asset[]
  memberships      OrganizationMembership[]
  invites          UserInvite[]
  faultDefinitions FaultDefinition[]
  procedures       Procedure[]
  auditEvents      AuditEvent[]

  @@map("organizations")
}

model Site {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  organization     Organization           @relation(fields: [organizationId], references: [id])
  name             String
  code             String                 @unique
  location         String
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  archivedAt       DateTime?              @map("archived_at")
  assets           Asset[]
  membershipAccess MembershipSiteAccess[]

  @@index([organizationId])
  @@map("sites")
}

model Asset {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  organization       Organization        @relation(fields: [organizationId], references: [id])
  siteId             String              @map("site_id") @db.Uuid
  site               Site                @relation(fields: [siteId], references: [id])
  assetTag           String              @unique @map("asset_tag")
  name               String
  description        String?
  equipmentType      String              @map("equipment_type")
  manufacturer       String
  model              String
  serialNumber       String?             @map("serial_number")
  location           String
  status             AssetStatus         @default(operational)
  nominalVoltageV    Decimal?            @map("nominal_voltage_v") @db.Decimal(10, 2)
  nominalCurrentA    Decimal?            @map("nominal_current_a") @db.Decimal(10, 2)
  commissionedAt     DateTime?           @map("commissioned_at") @db.Date
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  archivedAt         DateTime?           @map("archived_at")
  retiredAt          DateTime?           @map("retired_at")
  components         Component[]
  incidents          Incident[]
  measurements       Measurement[]
  maintenanceRecords MaintenanceRecord[]

  @@index([organizationId])
  @@index([siteId])
  @@map("assets")
}

model Component {
  id            String    @id @default(uuid()) @db.Uuid
  assetId       String    @map("asset_id") @db.Uuid
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  componentType String    @map("component_type")
  manufacturer  String
  model         String
  identifier    String?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  archivedAt    DateTime? @map("archived_at")

  @@index([assetId])
  @@map("components")
}

enum UserRole {
  technician
  supervisor
  admin
}

enum UserStatus {
  invited
  active
  disabled
}

enum MembershipStatus {
  active
  suspended
}

enum ProcedureStatus {
  draft
  approved
  withdrawn
}

enum IncidentPriority {
  low
  medium
  high
  critical
}

enum IncidentStatus {
  open
  investigating
  escalated
  resolved
  closed
}

enum RecordSource {
  voice
  manual
  imported
}

enum NoteSource {
  voice
  manual
  system
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  email                   String?                  @unique
  passwordHash            String?                  @map("password_hash")
  status                  UserStatus               @default(active)
  passwordChangedAt       DateTime?                @map("password_changed_at")
  lastLoginAt             DateTime?                @map("last_login_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  openedIncidents         Incident[]               @relation("OpenedBy")
  assignedIncidents       Incident[]               @relation("AssignedTo")
  notes                   IncidentNote[]
  measurements            Measurement[]
  maintenanceRecords      MaintenanceRecord[]
  acknowledgedEscalations Escalation[]             @relation("EscalationAcknowledgedBy")
  memberships             OrganizationMembership[]
  sessions                AuthSession[]
  invitesCreated          UserInvite[]             @relation("InviteCreatedBy")
  passwordResetTokens     PasswordResetToken[]
  approvedProcedures      Procedure[]              @relation("ProcedureApprovedBy")
  auditEvents             AuditEvent[]             @relation("AuditActor")

  @@map("users")
}

model OrganizationMembership {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String                 @map("user_id") @db.Uuid
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           UserRole               @default(technician)
  status         MembershipStatus       @default(active)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  siteAccess     MembershipSiteAccess[]
  auditEvents    AuditEvent[]           @relation("AuditMembership")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model MembershipSiteAccess {
  membershipId String                 @map("membership_id") @db.Uuid
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  siteId       String                 @map("site_id") @db.Uuid
  site         Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now()) @map("created_at")

  @@id([membershipId, siteId])
  @@index([siteId])
  @@map("membership_site_access")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model UserInvite {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  role           UserRole
  siteIds        Json         @default("[]") @map("site_ids")
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdById    String       @map("created_by") @db.Uuid
  createdBy      User         @relation("InviteCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("user_invites")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditEvent {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  organization      Organization            @relation(fields: [organizationId], references: [id])
  actorUserId       String?                 @map("actor_user_id") @db.Uuid
  actorUser         User?                   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembershipId String?                 @map("actor_membership_id") @db.Uuid
  actorMembership   OrganizationMembership? @relation("AuditMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)
  action            String
  resourceType      String                  @map("resource_type")
  resourceId        String?                 @map("resource_id")
  requestId         String?                 @map("request_id")
  ipAddress         String?                 @map("ip_address")
  userAgent         String?                 @map("user_agent")
  details           Json                    @default("{}")
  createdAt         DateTime                @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

model Procedure {
  id                         String            @id @default(uuid()) @db.Uuid
  organizationId             String            @map("organization_id") @db.Uuid
  organization               Organization      @relation(fields: [organizationId], references: [id])
  key                        String            @unique
  title                      String
  assetType                  String?           @map("asset_type")
  manufacturer               String?
  model                      String?
  safetyLevel                String            @map("safety_level")
  safetyConfirmationRequired Boolean           @default(true) @map("safety_confirmation_required")
  summary                    String
  steps                      Json
  approved                   Boolean           @default(false)
  status                     ProcedureStatus   @default(draft)
  approvedById               String?           @map("approved_by") @db.Uuid
  approvedBy                 User?             @relation("ProcedureApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt                 DateTime?         @map("approved_at")
  source                     String
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
  archivedAt                 DateTime?         @map("archived_at")
  faults                     FaultDefinition[]

  @@index([organizationId])
  @@index([approvedById])
  @@map("procedures")
}

model FaultDefinition {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  organization        Organization @relation(fields: [organizationId], references: [id])
  manufacturer        String
  model               String
  faultCode           String       @map("fault_code")
  normalizedFaultCode String       @map("normalized_fault_code")
  title               String
  description         String
  safetyLevel         String       @map("safety_level")
  source              String
  procedureId         String?      @map("procedure_id") @db.Uuid
  procedure           Procedure?   @relation(fields: [procedureId], references: [id])
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  archivedAt          DateTime?    @map("archived_at")

  @@unique([manufacturer, model, faultCode])
  @@index([organizationId])
  @@map("fault_definitions")
}

model Incident {
  requestId         String?            @unique @map("request_id") @db.Uuid
  requestHash       String?            @map("request_hash")
  source            RecordSource       @default(manual)
  id                String             @id @default(uuid()) @db.Uuid
  incidentNumber    String             @unique @default(dbgenerated("('INC-'::text || (nextval('incident_number_seq'::regclass))::text)")) @map("incident_number")
  assetId           String             @map("asset_id") @db.Uuid
  asset             Asset              @relation(fields: [assetId], references: [id])
  openedById        String             @map("opened_by") @db.Uuid
  openedBy          User               @relation("OpenedBy", fields: [openedById], references: [id])
  assignedToId      String?            @map("assigned_to") @db.Uuid
  assignedTo        User?              @relation("AssignedTo", fields: [assignedToId], references: [id])
  faultCode         String?            @map("fault_code")
  title             String
  description       String
  priority          IncidentPriority   @default(medium)
  status            IncidentStatus     @default(open)
  rootCause         String?            @map("root_cause")
  actionTaken       String?            @map("action_taken")
  resolutionSummary String?            @map("resolution_summary")
  completionPayload Json?              @map("completion_payload")
  openedAt          DateTime           @default(now()) @map("opened_at")
  resolvedAt        DateTime?          @map("resolved_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  notes             IncidentNote[]
  measurements      Measurement[]
  maintenanceRecord MaintenanceRecord?
  escalations       Escalation[]

  @@index([assetId, faultCode, openedAt])
  @@index([status])
  @@map("incidents")
}

model IncidentNote {
  requestId   String?    @unique @map("request_id") @db.Uuid
  requestHash String?    @map("request_hash")
  id          String     @id @default(uuid()) @db.Uuid
  incidentId  String     @map("incident_id") @db.Uuid
  incident    Incident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId    String?    @map("author_id") @db.Uuid
  author      User?      @relation(fields: [authorId], references: [id])
  note        String
  source      NoteSource @default(manual)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([incidentId, createdAt])
  @@map("incident_notes")
}

model Measurement {
  requestId       String?      @unique @map("request_id") @db.Uuid
  requestHash     String?      @map("request_hash")
  source          RecordSource @default(manual)
  id              String       @id @default(uuid()) @db.Uuid
  assetId         String       @map("asset_id") @db.Uuid
  asset           Asset        @relation(fields: [assetId], references: [id])
  incidentId      String?      @map("incident_id") @db.Uuid
  incident        Incident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  measurementType String       @map("measurement_type")
  value           Decimal      @db.Decimal(16, 6)
  unit            String
  notes           String?
  recordedById    String?      @map("recorded_by") @db.Uuid
  recordedBy      User?        @relation(fields: [recordedById], references: [id])
  recordedAt      DateTime     @default(now()) @map("recorded_at")

  @@index([assetId, recordedAt])
  @@index([incidentId])
  @@map("measurements")
}

model MaintenanceRecord {
  id           String       @id @default(uuid()) @db.Uuid
  assetId      String       @map("asset_id") @db.Uuid
  asset        Asset        @relation(fields: [assetId], references: [id])
  incidentId   String?      @unique @map("incident_id") @db.Uuid
  incident     Incident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  technicianId String?      @map("technician_id") @db.Uuid
  technician   User?        @relation(fields: [technicianId], references: [id])
  faultCode    String?      @map("fault_code")
  symptom      String
  rootCause    String       @map("root_cause")
  actionTaken  String       @map("action_taken")
  verification String
  source       RecordSource @default(manual)
  performedAt  DateTime     @default(now()) @map("performed_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([assetId, performedAt])
  @@map("maintenance_records")
}

model Escalation {
  id               String    @id @default(uuid()) @db.Uuid
  incidentId       String    @map("incident_id") @db.Uuid
  incident         Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  reason           String
  severity         String
  status           String    @default("pending")
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by") @db.Uuid
  acknowledgedBy   User?     @relation("EscalationAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([incidentId])
  @@index([acknowledgedById])
  @@map("escalations")
}
